# Copy this file to .env and fill in values. Never commit .env.

# Port the Express/Socket.IO server listens on.
PORT=3000

# Public base URL when deployed behind a reverse proxy, e.g.
# https://avesstudios.com/the-loom (no trailing slash). The join QR code then
# points phones at PUBLIC_URL/mobile.html. Leave blank for classroom LAN mode.
PUBLIC_URL=

# Frontend only (Vercel build): where the Socket.IO server lives, e.g.
# https://the-loom.onrender.com. Written into public/config.js by
# scripts/write-config.js. Leave blank when one server serves everything.
# LOOM_SOCKET_URL=

# Google AI Studio key for The Loom (Gemini). Server-side only; never sent to phones.
# Leave blank to run fully offline with authored fallbacks.
GEMINI_API_KEY=

# Optional: Gemini model (Flash-class). Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs key for the Loom's spoken voice. Server-side only; never sent to
# phones or committed. Leave blank to use the browser's built-in voice instead.
ELEVENLABS_API_KEY=
# Optional: voice and model. Defaults to Rowan (xzZRXG86mSM3naOyL9fa) and eleven_multilingual_v2.
# ELEVENLABS_VOICE_ID=xzZRXG86mSM3naOyL9fa
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional spend guard: max uncached ElevenLabs calls per hour (default 400).
# ELEVENLABS_MAX_CALLS_PER_HOUR=400

# Debate phase length in seconds: 90 (~16 min game) or 60 (~13.5 min game).
DEBATE_SECONDS=90

# Show the Loom's A/B forecast before the vote (true) or only at resolution (false).
SHOW_FORECAST_BEFORE_VOTE=false

# Debug: shrink every phase timer to 3 s for automated testing.
FAST_TIMERS=false

# Loom logging: every Gemini call logs latency and token usage ([loom] ...).
# LOOM_LOG=off silences it. LOOM_DEBUG_PROMPTS=true also logs prompts, but
# never student write-ins while LOOM_PRIVACY is on (the default).
LOOM_LOG=on
LOOM_PRIVACY=true
LOOM_DEBUG_PROMPTS=false
