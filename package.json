{
  "name": "societelos",
  "version": "1.0.0",
  "description": "A 5-player post-labor society classroom simulation",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "smoke": "node -e \"require('./server/gameEngine').smokeTest({ quiet: true }).catch((e) => { console.error(e.message); process.exit(1); })\"",
    "check": "node --check server/server.js && node --check server/socket.js && node --check server/gameEngine.js"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^4.18.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
